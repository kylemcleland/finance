generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A linked Plaid Item (one bank login). The access token is sensitive;
// the SQLite file stays local and is gitignored.
model PlaidItem {
  id            String    @id @default(cuid())
  itemId        String    @unique
  accessToken   String
  institutionId String?
  institution   String?
  cursor        String?   // transactions/sync cursor
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  accounts      Account[]
}

// A Hosted Link session we started and have not yet finished (exchanged).
model PlaidLinkSession {
  linkToken String   @id
  url       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A bank account or card. Finances are shared, so the account never says
// whose expense it was; but a card carried by one person is a hint about
// who was in the store. `cardholder` is "me" | "her" | null (joint).
model Account {
  id             String        @id @default(cuid())
  plaidAccountId String?       @unique
  name           String
  /// Our own name for the account, shown instead of the bank's. Sync never touches it.
  nickname       String?
  mask           String?
  type           String? // depository, credit, investment, ...
  subtype        String? // checking, credit card, 401k, cash management, ...
  cardholder     String?
  item           PlaidItem?    @relation(fields: [itemId], references: [id])
  itemId         String?
  transactions   Transaction[]
}

model Transaction {
  id                    String   @id @default(cuid())
  externalId            String   @unique // Plaid transaction_id or a CSV row hash
  source                String // "plaid" | "csv"
  date                  DateTime
  amount                Float // positive = money out, negative = refund/credit
  merchant              String // cleaned merchant name used for rule matching
  rawName               String // Plaid's transaction name (lightly cleaned by Plaid)
  originalDescription   String? // the bank's own description, verbatim; null for rows synced before we asked Plaid for it
  plaidCategoryPrimary  String?
  plaidCategoryDetailed String?
  pending               Boolean  @default(false)
  cardholderHint        String? // Plaid account_owner when the bank reports which cardholder swiped
  account               Account  @relation(fields: [accountId], references: [id])
  accountId             String

  // Classification result
  category             String? // our budget category
  shareMe              Int? // 0..100, percent of the expense allocated to "me"; rest is "her"
  classificationSource String? // "rule" | "plaid" | "claude" | "manual" | "unclassified"
  classifiedAt         DateTime?
  needsReview          Boolean  @default(false)
  note                 String?
  /// A one-off (a wedding deposit, a couch): counted as spending, left out of pace and yearly estimates.
  oneOff               Boolean  @default(false)

  @@index([date])
  @@index([merchant])
}

// Layer 1: our own overrides. Pattern is matched case-insensitively
// against the merchant name (substring) unless `exact` is true.
// shareMe null means "varies": the category is fixed but every purchase
// at this merchant needs its own split decision (Target, Amazon).
model MerchantRule {
  id        String   @id @default(cuid())
  pattern   String
  exact     Boolean  @default(false)
  category  String
  shareMe   Int? // 0 | 25 | 50 | 75 | 100, or null = varies
  note      String?
  /// Purchases at this merchant are one-offs (e.g. a wedding venue).
  oneOff    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([pattern, exact])
}

// Layer 3 cache: one Claude call per merchant, ever.
model MerchantCache {
  merchant  String   @id
  category  String
  shareMe   Int? // null = Claude judged this merchant varies; ask per purchase
  reason    String?
  model     String?
  createdAt DateTime @default(now())
}

// Our budget categories and monthly targets.
model Category {
  name          String @id
  monthlyBudget Float?
  sortOrder     Int    @default(0)
}

// An expense entered once that repeats every month (a mortgage paid from an
// account Plaid can't read). Each month's copy is an ordinary hand-entered
// transaction with externalId "recurring:<id>:<YYYY-MM>".
model RecurringExpense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String
  shareMe     Int
  dayOfMonth  Int // 1..31; a shorter month uses its last day
  startMonth  String // "YYYY-MM", the first month to fill
  lastMonth   String? // the latest month already filled; months after it are filled next
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Small bits of app state, e.g. the background sorting run's progress.
model AppState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
